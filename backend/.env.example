# Comma-separated browser origins permitted to call this API.
# Example production value:
# CORS_ORIGINS=https://app.example.in

CORS_ORIGINS=http://127.0.0.1:3000

# Runtime mode controls Secure cookies and whether development OTPs may be
# returned in API responses. Production must use an approved delivery provider.
LANDSIGHT_ENV=development
OTP_PROVIDER=development
AUTH_CHALLENGE_SECRET=replace_with_at_least_32_random_characters
SESSION_DAYS=7
MAX_UPLOAD_MB=50

# Local deterministic OCR/HTR configuration.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANGUAGES=hin+eng
KHATAUNI_ENABLE_HTR=1
KHATAUNI_HTR_MODEL=aayushpuri01/TrOCR-Devanagari
KHATAUNI_HTR_MAX_CROPS=4


# ==================================================
# Verified-record PDF export font (optional)
# ==================================================

# Optional absolute path to an installed Devanagari-capable font. Leave unset
# to use a supported system font (Mangal/Nirmala on Windows or Noto/Lohit on Linux).
# Render/Linux deployments should provision a Noto Devanagari font or set this path.
# BHUMIAI_PDF_FONT_PATH=/usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf


# ==================================================
# Verification Officer - Local Development Example
# ==================================================

# Server-side development officer account.
# Public application should not expose officer registration.

GOVERNMENT_OFFICER_ID=GOV-DEV-001
GOVERNMENT_OFFICER_EMAIL=officer@example.com
GOVERNMENT_OFFICER_NAME=Development Verification Officer
GOVERNMENT_OFFICER_PASSWORD=replace_with_a_strong_unique_password
