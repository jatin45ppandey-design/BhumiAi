# ==================================================
# Google OAuth
# ==================================================

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Add the callback below exactly to "Authorized redirect URIs" for local use.

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_STATE_SECRET=generate_a_strong_random_state_secret

GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
FRONTEND_URL=http://127.0.0.1:3000

# Comma-separated browser origins permitted to call this API.
# Example production value:
# CORS_ORIGINS=https://app.example.in

CORS_ORIGINS=http://127.0.0.1:3000


# ==================================================
# Verification Officer - Local Development Example
# ==================================================

# Server-side development officer account.
# Public application should not expose officer registration.

GOVERNMENT_OFFICER_ID=GOV-DEV-001
GOVERNMENT_OFFICER_EMAIL=officer@example.com
GOVERNMENT_OFFICER_NAME=Development Verification Officer
GOVERNMENT_OFFICER_PASSWORD=replace_with_a_strong_unique_password
